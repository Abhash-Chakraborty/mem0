# Abhash Memory - self-hosted server configuration.
#
# Copy to .env before starting the dev stack:
#     cp .env.example .env
#
# docker-compose.yaml reads this file and refuses to start without
# POSTGRES_PASSWORD and JWT_SECRET. Never commit the resulting .env.
#
# For production (docker-compose.prod.yaml) these same names are set as
# environment variables in Dokploy rather than from a file.

# --- Required ---------------------------------------------------------------

# Used for memory extraction and embeddings.
OPENAI_API_KEY=

# Postgres password for the bundled pgvector container. Any non-empty value
# works locally; use a generated secret in production.
POSTGRES_PASSWORD=change-me-locally

# Signs dashboard session tokens. Must be at least 16 characters.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=

# --- Optional: additional providers -----------------------------------------
# Bundled alongside OpenAI. Set the key for whichever you switch to on the
# Configuration page; see BUNDLED_*_PROVIDERS in main.py.
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# --- Authentication ---------------------------------------------------------

# Long random value that grants admin access without a dashboard login.
# Leave blank to require registering an admin at /setup instead.
ADMIN_API_KEY=

# Opens every protected endpoint. Local development only - never set true
# on anything reachable from a network.
AUTH_DISABLED=false

# --- Postgres ---------------------------------------------------------------

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_COLLECTION_NAME=memories

# Application database (auth, categories, webhooks, request logs). Separate
# from the vector store above.
APP_DB_NAME=mem0_app

# Seconds a single connect attempt may block before failing. Without a bound,
# an unreachable Postgres hangs startup instead of erroring.
POSTGRES_CONNECT_TIMEOUT=10

# --- Models -----------------------------------------------------------------

# Extraction / embedding models. The provider must be bundled (see main.py).
MEM0_DEFAULT_LLM_MODEL=gpt-5.4-nano
MEM0_DEFAULT_EMBEDDER_MODEL=text-embedding-3-small

# Category classification runs on a stronger model than extraction.
# Leave blank to reuse MEM0_DEFAULT_LLM_MODEL.
MEM0_CATEGORY_LLM_MODEL=gpt-5.4-mini

# Minimum confidence before an auto-assigned category is stored.
MEM0_CATEGORY_CONFIDENCE_FLOOR=0.45

# --- Dashboard --------------------------------------------------------------

DASHBOARD_URL=http://localhost:3000
NEXT_PUBLIC_INSTANCE_NAME=Abhash Memory

# --- Webhooks ---------------------------------------------------------------

MEM0_WEBHOOK_MAX_ATTEMPTS=5
MEM0_WEBHOOK_TIMEOUT_SECONDS=8

# --- Retention --------------------------------------------------------------

# Days of request_logs history kept when `make prune-logs` runs. Wire that
# command into cron in production. Leave blank to keep everything.
REQUEST_LOG_RETENTION_DAYS=30

# --- Telemetry --------------------------------------------------------------

# Anonymous onboarding event (install UUID, email domain, version). No PII.
MEM0_TELEMETRY=false
